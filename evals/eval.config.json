{
  "models": [
    {
      "id": "claude-code",
      "provider": "claude-code",
      "model": "claude-opus-5-5",
      "params": { "effort": "max", "max_parallel": 2, "timeout_seconds": 1800 }
    },
    {
      "id": "codex",
      "provider": "agent-cli",
      "model": "inherit",
      "params": { "profile": "codex", "max_parallel": 2 }
    },
    {
      "id": "gemini-cli",
      "provider": "agent-cli",
      "model": "inherit",
      "params": { "profile": "gemini", "max_parallel": 2 }
    },
    {
      "id": "copilot-cli",
      "provider": "agent-cli",
      "model": "inherit",
      "params": { "profile": "copilot", "max_parallel": 2 }
    },
    {
      "id": "cursor-cli",
      "provider": "agent-cli",
      "model": "inherit",
      "params": { "profile": "cursor", "max_parallel": 2 }
    },
    {
      "id": "anthropic-api",
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "params": { "effort": "medium", "fallbacks": "default" }
    },
    {
      "id": "openai-api",
      "provider": "openai",
      "model": "gpt-5",
      "params": { "api_key_env": "OPENAI_API_KEY" }
    },
    {
      "id": "gemini-api",
      "provider": "openai",
      "model": "gemini-2.5-pro",
      "params": {
        "api_key_env": "GEMINI_API_KEY",
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "token_param": "max_tokens"
      }
    },
    {
      "id": "local-ollama",
      "provider": "openai",
      "model": "llama3.1",
      "params": { "local": true, "base_url": "http://localhost:11434/v1", "token_param": "max_tokens", "max_tokens": 8000 }
    }
  ],
  "judge": {
    "use": "subject",
    "params": { "effort": "high" }
  },
  "arms": ["with-skill", "baseline"],
  "trials": 3,
  "concurrency": 4,
  "max_turns": 12,
  "pass_threshold": 0.8,
  "baseline_system_prompt": "You are an expert AI product manager at a large enterprise. Give rigorous, practical, decision-ready guidance.",
  "gates": {
    "min_with_skill_score": 0.8,
    "max_with_skill_critical_failures": 0,
    "min_delta": 0.0,
    "max_regression": 0.05
  },
  "pricing_per_mtok": {
    "claude-opus-5-5": { "input": 4.0, "output": 20.0, "cache_read": 0.2 },
    "claude-sonnet-5-5": { "input": 2.0, "output": 10.0, "cache_read": 0.2 },
    "claude-haiku-4-5": { "input": 1.0, "output": 5.0 }
  }
}
